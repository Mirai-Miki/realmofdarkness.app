# ===========================================
# Realm of Darkness - Environment Variables
# ===========================================
# Single source of truth for all environment configuration

# ===========================================
# SHARED ENVIRONMENT
# ===========================================
NODE_ENV=development

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string for Drizzle ORM
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/realm_of_darkness

# ===========================================
# LOGGING
# ===========================================
ENABLE_CONSOLE_LOGGING=true
ENABLE_DISCORD_LOGGING=false
LOGGER_TOKEN=
LOGGER_CHANNEL_ID=
LOG_FILE_PATH=

# ===========================================
# DISCORD BOT - CLIENT IDS
# ===========================================
# From Discord Developer Portal → Your Application → Application ID
CLIENT_ID_5TH=your_v5_bot_client_id
CLIENT_ID_20TH=your_v20_bot_client_id
CLIENT_ID_COD=your_cod_bot_client_id

# ===========================================
# DISCORD BOT - TOKENS
# ===========================================
# From Discord Developer Portal → Your Application → Bot → Token
TOKEN_5TH=your_v5_bot_token
TOKEN_20TH=your_v20_bot_token
TOKEN_COD=your_cod_bot_token

# ===========================================
# DISCORD BOT - SETTINGS
# ===========================================
# Development server ID for testing slash commands
DEV_SERVER_ID=your_test_server_id

# Bot token for emoji script (must be from a bot that can see the emojis)
EMOJI_SCRIPT_TOKEN=your_bot_token_for_emoji_script

# ===========================================
# API SETTINGS
# ===========================================
API_PORT=3000
