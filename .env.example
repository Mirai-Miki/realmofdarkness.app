# ===========================================
# Root Environment Variables
# ===========================================
# These variables are shared across the monorepo

# Node Environment
NODE_ENV=development

# Database Configuration
# PostgreSQL connection string for Drizzle ORM
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/realm_of_darkness

# Logging Configuration (for @packages/core logger)
# Optional: Custom log file path (defaults to root/logs)
# LOG_FILE_PATH=

# Optional: Enable/disable console logging (defaults based on NODE_ENV)
# ENABLE_CONSOLE_LOGGING=true

# Optional: Enable Discord logging for errors
# ENABLE_DISCORD_LOGGING=false
# LOGGER_TOKEN=your_discord_bot_token_for_logging
# LOGGER_CHANNEL_ID=your_discord_channel_id_for_logs
