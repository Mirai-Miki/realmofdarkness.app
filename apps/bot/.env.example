# ===========================================
# Discord Bot Environment Variables
# ===========================================
# NOTE: NODE_ENV and DATABASE_URL are inherited from root .env file

# Bot Type (for single bot mode)
# Options: COD, 5TH, 20TH
# Leave commented out to run all bots via shard-launcher
# BOT_TYPE=COD

# Discord Bot Client IDs (from Discord Developer Portal)
CLIENT_ID_5TH=your_v5_bot_client_id
CLIENT_ID_20TH=your_v20_bot_client_id
CLIENT_ID_COD=your_cod_bot_client_id

# Discord Bot Tokens (from Discord Developer Portal)
TOKEN_5TH=your_v5_bot_token
TOKEN_20TH=your_v20_bot_token
TOKEN_COD=your_cod_bot_token

# Development Server ID (for testing slash commands)
DEV_SERVER_ID=your_test_server_id

# Error Logging Channel
# Discord channel ID where errors will be logged
ERROR_CHANNEL_ID=776761322859266050

# Backend API Integration
API_KEY=your_api_key_matching_backend
API_HOST=127.0.0.1
API_BASE_URL=http://localhost:8080

# Database Configuration (inherited from root, but can override)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/realm_of_darkness

# Emoji Script Token (for get-emojis.js script)
EMOJI_SCRIPT_TOKEN=your_bot_token_for_emoji_script

# Logging Configuration (optional overrides)
# ENABLE_CONSOLE_LOGGING=true
# ENABLE_DISCORD_LOGGING=false
# LOGGER_TOKEN=your_discord_bot_token_for_logging
# LOGGER_CHANNEL_ID=your_discord_channel_id_for_logs
# LOG_FILE_PATH=
