{
  "name": "@realm/bot",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "tsx scripts/deploy-commands.ts && tsx scripts/sync-emojis.ts",
    "build": "tsc",
    "clean": "rimraf dist .turbo",
    "typecheck": "tsc --noEmit",
    "dev": "nodemon --exec \"turbo run build --filter=@realm/bot... && tsx src/shard-launcher.ts\"",
    "dev:5th": "nodemon --exec \"turbo run build --filter=@realm/bot... && tsx src/shard-launcher.ts 5th\"",
    "dev:20th": "nodemon --exec \"turbo run build --filter=@realm/bot... && tsx src/shard-launcher.ts 20th\"",
    "dev:cod": "nodemon --exec \"turbo run build --filter=@realm/bot... && tsx src/shard-launcher.ts cod\"",
    "start": "node dist/shard-launcher.js",
    "deploy-commands": "tsx scripts/deploy-commands.ts",
    "emoji:sync": "tsx scripts/sync-emojis.ts",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\"",
    "lint": "eslint . --ext .js,.ts"
  },
  "dependencies": {
    "@realm/assets": "workspace:*",
    "@realm/common": "workspace:*",
    "@realm/core": "workspace:*",
    "@realm/logger": "workspace:*",
    "@realm/repositories": "workspace:*",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "fs-extra": "^11.3.3",
    "nodemon": "^3.1.11",
    "tsx": "^4.21.0"
  }
}
