{
  "name": "realm-of-darkness",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:types": "tsc -b",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "git clean -fdX .",
    "migrate": "pnpm --filter database exec drizzle-kit migrate",
    "db:generate": "pnpm --filter database run generate",
    "db:studio": "pnpm --filter database run studio",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\""
  },
  "dependencies": {
    "source-map-support": "^0.5.21",
    "tsup": "^8.5.0",
    "drizzle-orm": "^0.44.4",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/source-map-support": "^0.5.10",
    "typescript": "^5.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "tsconfig-paths": "^4.2.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.18.0",
    "typescript-eslint": "^8.40.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@eslint/js": "^9.18.0",
    "globals": "^16.3.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "prettier": "^3.5.3",
    "turbo": "^2.0.0",
    "@types/jest": "^30.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.5",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4"
  }
}
