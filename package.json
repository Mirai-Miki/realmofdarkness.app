{
  "name": "realm-of-darkness",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:bot": "turbo run dev --filter=@realm/bot",
    "dev:bot:5th": "turbo run dev:5th --filter=@realm/bot",
    "dev:bot:20th": "turbo run dev:20th --filter=@realm/bot",
    "dev:bot:cod": "turbo run dev:cod --filter=@realm/bot",
    "dev:api": "turbo run dev --filter=@realm/api",

    "build": "turbo run build deploy emoji:sync",
    "build:bot": "turbo run build deploy emoji:sync --filter=@realm/bot",
    "build:api": "turbo run build --filter=@realm/api",
    "build:types": "tsc -b",

    "bot:emoji:sync": "turbo run emoji:sync --filter=@realm/bot",

    "db:migrate": "turbo run migrate --filter=@realm/database",
    "db:generate": "turbo run generate --filter=@realm/database",
    "db:studio": "turbo run studio --filter=@realm/database",
    "db:reset": "turbo run reset --filter=@realm/database",

    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "node scripts/clean.mjs",
    "clean:dist": "turbo run clean",
    "clean-build": "pnpm clean && pnpm install && pnpm build",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,mdx,yml,yaml,css,scss}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.3.0",
    "glob": "^11.1.0",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.1.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
