{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": "./src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "paths": {
      "types": ["./types.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
