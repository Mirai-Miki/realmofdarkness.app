{
  "name": "@realm/core",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist coverage .turbo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
