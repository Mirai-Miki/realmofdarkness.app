{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": "./src",
    "paths": {
      "@/*": ["./*"],
      "domain": ["./domain"],
      "domain/*": ["./domain/*"],
      "application": ["./application"],
      "application/*": ["./application/*"],
      "types": ["./types"],
      "types/*": ["./types/*"],
      "utils": ["./utils"],
      "utils/*": ["./utils/*"],
      "validations": ["./validations"],
      "validations/*": ["./validations/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../../packages/common" }]
}
