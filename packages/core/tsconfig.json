{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "isolatedModules": true,
    "types": ["node", "jest"],
    "paths": {
      "@/*": ["./src/*"],
      "domain": ["./src/domain"],
      "domain/*": ["./src/domain/*"],
      "application": ["./src/application"],
      "application/*": ["./src/application/*"],
      "types": ["./src/types"],
      "types/*": ["./src/types/*"],
      "utils": ["./src/utils"],
      "utils/*": ["./src/utils/*"],
      "validations": ["./src/validations"],
      "validations/*": ["./src/validations/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "../../packages/common/tsconfig.build.json" }]
}
