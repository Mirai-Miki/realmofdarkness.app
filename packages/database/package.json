{
  "name": "@realm/database",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "generate": "drizzle-kit generate --config=src/drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=src/drizzle.config.ts",
    "studio": "drizzle-kit studio --config=src/drizzle.config.ts",
    "reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@realm/common": "workspace:*",
    "drizzle-orm": "^0.44.7",
    "pg": "^8.16.3",
    "dotenv": "^17.2.3",
    "tsup": "^8.5.1"
  },
  "devDependencies": {
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.7"
  }
}
