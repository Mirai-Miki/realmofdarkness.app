{
  "name": "@realm/database",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm typecheck && tsup",
    "clean": "rimraf dist .turbo",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "generate": "drizzle-kit generate --config=src/drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=src/drizzle.config.ts",
    "studio": "drizzle-kit studio --config=src/drizzle.config.ts",
    "reset": "tsx scripts/reset-db.ts"
  },
  "dependencies": {
    "@realm/common": "workspace:*",
    "dotenv": "workspace:*",
    "drizzle-orm": "workspace:*",
    "zod": "workspace:*",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.16.3",
    "tsup": "workspace:*"
  },
  "devDependencies": {
    "@types/pg": "^8.16.0",
    "drizzle-kit": "^0.31.8"
  }
}
