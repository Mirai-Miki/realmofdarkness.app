{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "ENABLE_CONSOLE_LOGGING",
    "ENABLE_DISCORD_LOGGING",
    "LOGGER_TOKEN",
    "LOGGER_CHANNEL_ID",
    "LOG_FILE_PATH",
    "CLIENT_ID_5TH",
    "CLIENT_ID_20TH",
    "CLIENT_ID_COD",
    "TOKEN_5TH",
    "TOKEN_20TH",
    "TOKEN_COD",
    "DEV_SERVER_ID",
    "ERROR_CHANNEL_ID",
    "EMOJI_SCRIPT_TOKEN",
    "API_PORT",
    "API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "!dist/**/*.map"],
      "env": ["NODE_ENV"]
    },
    "lint": {
      "outputs": [],
      "env": ["NODE_ENV"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "env": ["NODE_ENV", "DATABASE_URL"],
      "cache": false
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "NODE_ENV",
        "DATABASE_URL",
        "ENABLE_CONSOLE_LOGGING",
        "ENABLE_DISCORD_LOGGING",
        "LOGGER_TOKEN",
        "LOGGER_CHANNEL_ID",
        "LOG_FILE_PATH"
      ]
    },
    "migrate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "generate": {
      "cache": false,
      "env": ["DATABASE_URL", "NODE_ENV"]
    },
    "studio": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "NODE_ENV"]
    }
  }
}
